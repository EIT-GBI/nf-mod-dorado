// As tests.config, plus dorado flags passed the way a consuming pipeline passes
// them: through ext.args.
//
// The image is not named here. conf/module.config is what declares it, pinned
// to the version release.yml keeps in step with manifest.version, and including
// it means the tests run against exactly the image a consuming pipeline gets.
includeConfig 'conf/module.config'

docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: 'DORADO_.*' {
        cpus = 1
    }
    withName: DORADO_TRIM {
        ext.args = '--no-trim-primers'
    }
    withName: DORADO_ALIGNER {
        // the double quotes are load-bearing: --mm2-opts takes one string
        ext.args = '--mm2-opts "-x map-ont"'
    }
}
