// Container for the dorado module processes.
//
// Consuming pipelines pick this up with:
//     includeConfig 'modules/dorado/conf/module.config'
//
// It deliberately carries no manifest{} block: including one would overwrite
// the consuming pipeline's own manifest, silently dropping its name, version
// and nextflowVersion floor.
//
// The tag is kept in step with manifest.version by .github/workflows/release.yml,
// so a checkout at any release tag references the image built from that same commit.
//
// Only the image is set here. GPU resources (accelerator, containerOptions such
// as `--gpus all` / `--nv`, cluster queue) depend on the executor and belong in
// the consuming pipeline's config.
process {
    withName: 'DORADO_.*' {
        container = 'ghcr.io/eit-gbi/nf-mod-dorado:v1.0.0'
    }
}
