nextflow_process {

    name "Test DORADO_BASECALLER"
    script "../main.nf"
    process "DORADO_BASECALLER"

    // Stub only: basecalling needs an NVIDIA GPU, which CI runners do not have
    // (the same reason nf-mod-parabricks is stub-tested).
    def TEST_POD5 = 'file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/nanopore/pod5/test.pod5", checkIfExists: true)'

    test("DORADO_BASECALLER - stub - wiring and output names") {

        options "-stub-run"

        when {
            process {
                """
                input[0] = [[id:'test'], ${TEST_POD5}]
                input[1] = '/opt/models/dna_r10.4.1_e8.2_400bps_sup@v5.0.0'
                """
            }
        }

        then {
            assert process.success
            assert process.out.ubam
            assert file(process.out.ubam[0][1]).name == 'test.dorado.bam'
        }
    }
}
