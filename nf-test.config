config {
    testsDir "."
    workDir ".nf-test"
    configFile "nextflow.config"

    // Reads SAM/BAM contents in assertions. BAM md5s are not stable on their
    // own: dorado records its command line (including -t task.cpus) in an @PG
    // header line, so the file checksum moves whenever the config does. This
    // plugin checksums the reads only.
    plugins {
        load "nft-bam@0.7.0"
    }
}
