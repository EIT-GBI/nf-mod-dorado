// Config for the dorado tests that run the tool for real, rather than checking
// stub wiring. Only DORADO_TRIM and DORADO_ALIGNER have such tests: they run on
// CPU. DORADO_BASECALLER needs a GPU, which CI runners do not have.
//
// The image is not named here. conf/module.config is what declares it, pinned
// to the version release.yml keeps in step with manifest.version, and including
// it means the tests run against exactly the image a consuming pipeline gets.
includeConfig 'conf/module.config'

docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: 'DORADO_.*' {
        cpus = 1
    }
}
